diff --git a/src/lib/clipboard.ts b/src/lib/clipboard.ts
new file mode 100644
index 0000000..52152b1
--- /dev/null
+++ b/src/lib/clipboard.ts
@@ -0,0 +1,25 @@
+/** Copia texto. Funciona em HTTPS e também em http:// (onde `navigator.clipboard` não existe). */
+export async function copyText(text: string): Promise<boolean> {
+  try {
+    if (typeof window !== "undefined" && window.isSecureContext && navigator.clipboard?.writeText) {
+      await navigator.clipboard.writeText(text);
+      return true;
+    }
+  } catch {
+    // cai para o método antigo abaixo
+  }
+  try {
+    const ta = document.createElement("textarea");
+    ta.value = text;
+    ta.setAttribute("readonly", "");
+    ta.style.cssText = "position:fixed;top:0;left:0;opacity:0;pointer-events:none";
+    document.body.appendChild(ta);
+    ta.select();
+    ta.setSelectionRange(0, text.length);
+    const ok = document.execCommand("copy");
+    document.body.removeChild(ta);
+    return ok;
+  } catch {
+    return false;
+  }
+}
