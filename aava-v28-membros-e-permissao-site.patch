diff --git a/src/test/member-list.test.ts b/src/test/member-list.test.ts
new file mode 100644
index 0000000..120a6de
--- /dev/null
+++ b/src/test/member-list.test.ts
@@ -0,0 +1,113 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { countByStatus, registrationNumber, sortMembers } from "@/lib/member-list";
+
+const people = [
+  {
+    full_name: "Carlos Souza",
+    birth_date: "1990-05-10",
+    registration_number: "0012",
+    status: "membro",
+  },
+  { full_name: "Ana Lima", birth_date: "1960-01-02", registration_number: "3", status: "membro" },
+  { full_name: "Álvaro Dias", birth_date: null, registration_number: null, status: "inativo" },
+  {
+    full_name: "Bruno Reis",
+    birth_date: "2005-12-31",
+    registration_number: "105",
+    status: "afastado",
+  },
+  { full_name: "Zélia Prado", birth_date: "1975-07-07", registration_number: "", status: "membro" },
+];
+const names = (l: { full_name: string }[]) => l.map((m) => m.full_name);
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date("2026-11-07T12:00:00"));
+});
+afterEach(() => vi.useRealTimers());
+
+describe("sortMembers", () => {
+  it("nome A–Z e Z–A, ignorando acento", () => {
+    expect(names(sortMembers(people, "nome_asc"))).toEqual([
+      "Álvaro Dias",
+      "Ana Lima",
+      "Bruno Reis",
+      "Carlos Souza",
+      "Zélia Prado",
+    ]);
+    expect(names(sortMembers(people, "nome_desc"))).toEqual([
+      "Zélia Prado",
+      "Carlos Souza",
+      "Bruno Reis",
+      "Ana Lima",
+      "Álvaro Dias",
+    ]);
+  });
+
+  it("idade do maior para o menor e do menor para o maior, sem data de nascimento sempre no fim", () => {
+    expect(names(sortMembers(people, "idade_desc"))).toEqual([
+      "Ana Lima",
+      "Zélia Prado",
+      "Carlos Souza",
+      "Bruno Reis",
+      "Álvaro Dias",
+    ]);
+    expect(names(sortMembers(people, "idade_asc"))).toEqual([
+      "Bruno Reis",
+      "Carlos Souza",
+      "Zélia Prado",
+      "Ana Lima",
+      "Álvaro Dias",
+    ]);
+  });
+
+  it("matrícula numérica (3 vem antes de 105), sem matrícula sempre no fim", () => {
+    expect(names(sortMembers(people, "matricula_asc"))).toEqual([
+      "Ana Lima",
+      "Carlos Souza",
+      "Bruno Reis",
+      "Álvaro Dias",
+      "Zélia Prado",
+    ]);
+    expect(names(sortMembers(people, "matricula_desc"))).toEqual([
+      "Bruno Reis",
+      "Carlos Souza",
+      "Ana Lima",
+      "Álvaro Dias",
+      "Zélia Prado",
+    ]);
+  });
+
+  it("não altera a lista original", () => {
+    const before = names(people);
+    sortMembers(people, "nome_desc");
+    expect(names(people)).toEqual(before);
+  });
+
+  it("lê matrícula com zeros à esquerda", () => {
+    expect(registrationNumber({ registration_number: "0012" })).toBe(12);
+    expect(registrationNumber({ registration_number: " " })).toBeNull();
+  });
+});
+
+describe("countByStatus", () => {
+  it("conta cada status separado, na ordem do sistema, sem os que têm zero", () => {
+    expect(countByStatus(people)).toEqual([
+      { status: "membro", label: "Membro", count: 3 },
+      { status: "afastado", label: "Afastado", count: 1 },
+      { status: "inativo", label: "Inativo", count: 1 },
+    ]);
+  });
+
+  it("não deixa sumir um status desconhecido e ignora visitantes", () => {
+    const r = countByStatus([
+      { status: "novo_status" },
+      { status: "visitante" },
+      { status: "membro" },
+    ]);
+    expect(r.map((x) => [x.status, x.count])).toEqual([
+      ["membro", 1],
+      ["novo_status", 1],
+    ]);
+  });
+});
diff --git a/supabase/migrations/20261107130000_edit_site_permission.sql b/supabase/migrations/20261107130000_edit_site_permission.sql
new file mode 100644
index 0000000..fa64178
--- /dev/null
+++ b/supabase/migrations/20261107130000_edit_site_permission.sql
@@ -0,0 +1,59 @@
+-- Permissão "edit_site": quem recebe essa permissão em "Usuários e permissões" pode editar a landing page.
+--
+-- user_permissions.permission é texto livre, então a permissão nova não precisa de mudança na tabela.
+-- has_permission() já devolve verdadeiro para CEO e pastor presidente, que continuam editando como antes.
+--
+-- 1) site_content (texto, links, fotos, horários): escrita liberada para quem tem "edit_site".
+-- 2) Bucket site-assets (fotos do site): envio, troca e remoção liberados para quem tem "edit_site".
+-- 3) Pix e métodos de contribuição ficam só com CEO e pastor presidente: um gatilho mantém os valores atuais
+--    de pixKeys e methods quando a alteração vem de quem não é liderança (vale também para chamadas diretas
+--    à API, não só para a tela). Mudar quem pode mexer em dinheiro continua sendo decisão da liderança.
+
+drop policy if exists "leadership site insert" on public.site_content;
+drop policy if exists "site editors insert" on public.site_content;
+create policy "site editors insert" on public.site_content for insert to authenticated
+  with check (public.has_permission(auth.uid(), 'edit_site'));
+
+drop policy if exists "leadership site update" on public.site_content;
+drop policy if exists "site editors update" on public.site_content;
+create policy "site editors update" on public.site_content for update to authenticated
+  using (public.has_permission(auth.uid(), 'edit_site'))
+  with check (public.has_permission(auth.uid(), 'edit_site'));
+
+drop policy if exists "site assets insert" on storage.objects;
+create policy "site assets insert" on storage.objects for insert to authenticated
+  with check (bucket_id = 'site-assets' and public.has_permission(auth.uid(), 'edit_site'));
+
+drop policy if exists "site assets update" on storage.objects;
+create policy "site assets update" on storage.objects for update to authenticated
+  using (bucket_id = 'site-assets' and public.has_permission(auth.uid(), 'edit_site'))
+  with check (bucket_id = 'site-assets' and public.has_permission(auth.uid(), 'edit_site'));
+
+drop policy if exists "site assets delete" on storage.objects;
+create policy "site assets delete" on storage.objects for delete to authenticated
+  using (bucket_id = 'site-assets' and public.has_permission(auth.uid(), 'edit_site'));
+
+drop policy if exists "site assets select" on storage.objects;
+create policy "site assets select" on storage.objects for select to authenticated
+  using (bucket_id = 'site-assets' and public.has_permission(auth.uid(), 'edit_site'));
+
+create or replace function public.site_content_guard_finance()
+returns trigger language plpgsql security definer set search_path = public as $$
+begin
+  -- Sem usuário (migrations, chave de serviço) e liderança: o conteúdo segue como veio.
+  if auth.uid() is null or public.is_church_leadership(auth.uid()) then
+    return new;
+  end if;
+  if tg_op = 'INSERT' then
