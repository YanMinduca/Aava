+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+
+const h = vi.hoisted(() => ({ rpc: vi.fn(), toastError: vi.fn(), toastSuccess: vi.fn() }));
+vi.mock("sonner", () => ({ toast: { error: h.toastError, success: h.toastSuccess } }));
+vi.mock("@/integrations/supabase/client", () => ({ supabase: { rpc: h.rpc } }));
+
+import { TicketRemoval } from "@/components/events/TicketRemoval";
+import type { Tables } from "@/integrations/supabase/types";
+
+const ticket = (over: Partial<Tables<"event_tickets">>): Tables<"event_tickets"> => ({
+  id: "t1",
+  registration_id: "r1",
+  event_id: "e1",
+  seq: 1,
+  code: "c",
+  short_code: "K7M29QXA",
+  holder_name: "Ana Souza",
+  status: "valid",
+  checked_in_at: null,
+  checked_in_by: null,
+  created_at: "2026-11-01T10:00:00Z",
+  removal_id: null,
+  ...over,
+});
+const reg = { id: "r1", status: "confirmed", quantity: 3, unit_price: 50 };
+
+function renderIt(props: Partial<React.ComponentProps<typeof TicketRemoval>> = {}) {
+  const onChange = vi.fn();
+  const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  render(
+    <QueryClientProvider client={qc}>
+      <TicketRemoval
+        reg={reg}
+        tickets={[
+          ticket({ id: "t1", seq: 1 }),
+          ticket({ id: "t2", seq: 2, holder_name: "Ana Souza (2)" }),
+          ticket({ id: "t3", seq: 3, holder_name: "Ana Souza (3)", status: "checked_in" }),
+        ]}
+        removals={[]}
+        paidSum={150}
+        onChange={onChange}
+        {...props}
+      />
+    </QueryClientProvider>,
+  );
+  return onChange;
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  h.rpc.mockResolvedValue({ data: { refund_due: 50 }, error: null });
+});
+afterEach(cleanup);
+
+describe("remoção de ingressos no painel", () => {
+  it("ingresso com presença confirmada não pode ser marcado", () => {
+    renderIt();
+    expect(
+      (screen.getByLabelText("Remover o ingresso de Ana Souza (3)") as HTMLButtonElement).disabled,
+    ).toBe(true);
+  });
+
+  it("sem observação não confirma; com observação chama a função com os ingressos escolhidos", async () => {
+    const onChange = renderIt();
+    fireEvent.click(screen.getByLabelText("Remover o ingresso de Ana Souza (2)"));
+    fireEvent.click(screen.getByRole("button", { name: /Remover selecionados \(1\)/ }));
+    const confirm = screen.getByRole("button", { name: "Confirmar remoção" }) as HTMLButtonElement;
+    expect(confirm.disabled).toBe(true);
+    expect(screen.getByTestId("removal-summary").textContent).toMatch(/2 ingressos/);
+    expect(screen.getByTestId("removal-summary").textContent).toMatch(/a devolver/);
+    fireEvent.change(screen.getByLabelText(/Observação/), {
+      target: { value: "  Pessoa   desistiu " },
+    });
+    await waitFor(() => expect(confirm.disabled).toBe(false));
+    fireEvent.click(confirm);
+    await waitFor(() =>
+      expect(h.rpc).toHaveBeenCalledWith("remove_event_tickets", {
+        _reg: "r1",
+        _reason: "Pessoa desistiu",
+        _ticket_ids: ["t2"],
+      }),
+    );
+    await waitFor(() => expect(onChange).toHaveBeenCalled());
+  });
+
+  it("inscrição ainda sem ingressos: remove por quantidade", async () => {
+    renderIt({ reg: { ...reg, status: "pending", quantity: 2 }, tickets: [], paidSum: 0 });
+    fireEvent.click(screen.getByRole("button", { name: "Remover ingressos" }));
+    fireEvent.change(screen.getByLabelText(/Quantos ingressos/), { target: { value: "2" } });
+    expect(screen.getByTestId("removal-summary").textContent).toMatch(/cancelada/);
+    fireEvent.change(screen.getByLabelText(/Observação/), { target: { value: "Duplicada" } });
+    fireEvent.click(screen.getByRole("button", { name: "Confirmar remoção" }));
+    await waitFor(() =>
+      expect(h.rpc).toHaveBeenCalledWith("remove_event_tickets", {
+        _reg: "r1",
+        _reason: "Duplicada",
+        _quantity: 2,
+      }),
+    );
+  });
+
+  it("mostra o motivo no ingresso removido e não oferece remover de novo", () => {
+    renderIt({
+      tickets: [ticket({ id: "t1", status: "cancelled", removal_id: "x1" })],
+      removals: [
+        {
+          id: "x1",
+          event_id: "e1",
+          registration_id: "r1",
+          tickets_removed: 1,
+          holder_names: [],
+          reason: "Pagamento não identificado",
+          registration_cancelled: false,
+          refund_due: 0,
+          removed_by: null,
+          removed_at: "2026-11-02T10:00:00Z",
+        },
+      ],
+    });
+    expect(screen.getAllByText(/Pagamento não identificado/).length).toBeGreaterThan(0);
+    expect(
+      (screen.getByLabelText("Remover o ingresso de Ana Souza") as HTMLButtonElement).disabled,
+    ).toBe(true);
+  });
+});
diff --git a/supabase/migrations/20261110010000_event_ask_religion.sql b/supabase/migrations/20261110010000_event_ask_religion.sql
new file mode 100644
index 0000000..4c11552
--- /dev/null
+++ b/supabase/migrations/20261110010000_event_ask_religion.sql
@@ -0,0 +1,99 @@
+-- Evento passa a poder pedir (ou não) a religião dos visitantes na inscrição.
+-- Padrão: ligado (true), então os eventos que já existem continuam se comportando como antes.
+-- Quando desligado: a tela não mostra a pergunta nem o aceite de dado sensível, e register_for_event não exige nem
+-- grava a religião do visitante. Membros continuam registrados como "membro_igreja" (não é pergunta, vem do cadastro).
+-- A assinatura de register_for_event não muda; só o corpo. Idempotente.
+
+alter table public.events add column if not exists ask_religion boolean not null default true;
+
+create or replace function public.register_for_event(
+  _event uuid, _lot uuid, _quantity integer, _cpf text,
+  _installments integer default 1, _image_consent boolean default false,
+  _institution text default null, _religion text default null
+)
+returns uuid
+language plpgsql
+security definer
+set search_path to 'public'
+as $function$
+declare
+  uid uuid := auth.uid();
+  ev public.events%rowtype; lt public.event_lots%rowtype; m public.members%rowtype;
+  is_member boolean; d text; used int; total numeric; reg uuid; pay_required boolean; n int; base numeric; i int;
+  consent boolean; v_institution text; v_religion text;
+begin
+  if uid is null then raise exception 'login_required'; end if;
+  select * into ev from public.events where id = _event and published;
+  if not found then raise exception 'event_not_found'; end if;
+  if now() < coalesce(ev.registration_opens_at, '-infinity') or now() > coalesce(ev.registration_closes_at, 'infinity') then
+    raise exception 'registration_closed';
+  end if;
+  -- Autorização de uso de imagem: obrigatória quando o evento exige
+  consent := ev.require_image_consent and coalesce(_image_consent, false);
+  if ev.require_image_consent and not consent then raise exception 'image_consent_required'; end if;
+
+  select * into lt from public.event_lots where id = _lot and event_id = _event for update;
+  if not found then raise exception 'lot_not_found'; end if;
+  if (lt.opens_at is not null and now() < lt.opens_at) or (lt.closes_at is not null and now() > lt.closes_at) then
+    raise exception 'lot_closed';
+  end if;
+  select * into m from public.members where user_id = uid;
+  if not found then raise exception 'profile_required'; end if;
+  is_member := m.approval_status = 'aprovado' and m.status <> 'visitante';
+  -- Questionário só para visitantes; membros ficam resumidos como "Membro da igreja".
+  -- A religião só é pedida (e guardada) quando o evento está com "pedir religião" ligado.
+  if is_member then
+    v_institution := 'Membro da igreja';
+    v_religion := 'membro_igreja';
+  else
+    if nullif(btrim(coalesce(_institution, '')), '') is null or length(btrim(_institution)) > 120 then raise exception 'invalid_institution'; end if;
+    v_institution := btrim(_institution);
+    if ev.ask_religion then
+      if _religion is null or _religion not in ('evangelico', 'catolico', 'espirita', 'matriz_africana', 'outros') then raise exception 'invalid_religion'; end if;
+      v_religion := _religion;
+    else
+      v_religion := null;
+    end if;
+  end if;
+  if ev.audience = 'members' and not is_member and not lt.public_access then raise exception 'members_only'; end if;
+  if _quantity is null or _quantity < 1 or _quantity > 10 then raise exception 'invalid_quantity'; end if;
+
+  d := regexp_replace(coalesce(nullif(btrim(_cpf), ''), m.cpf, ''), '\D', '', 'g');
+  if ev.limit_per_person then
+    if not public.is_valid_cpf(d) then raise exception 'invalid_cpf'; end if;
+    select coalesce(sum(r.quantity), 0) into used from public.event_registrations r
+      where r.event_id = _event and r.status <> 'cancelled' and not r.is_child
+        and (r.user_id = uid or regexp_replace(coalesce(r.attendee_cpf, ''), '\D', '', 'g') = d);
+    if used + _quantity > coalesce(ev.max_per_person, 1) then raise exception 'limit_exceeded'; end if;
+  elsif d <> '' and not public.is_valid_cpf(d) then
+    raise exception 'invalid_cpf';
+  end if;
+
+  if lt.capacity is not null and public.lot_taken(lt.id) + _quantity > lt.capacity then raise exception 'sold_out'; end if;
+
+  pay_required := ev.payment_enabled and lt.price > 0;
+  total := lt.price * _quantity;
+  n := case when pay_required and coalesce(_installments, 1) > 1 then _installments else 1 end;
+  if n > 1 and (not ev.allow_installments or n > ev.max_installments) then raise exception 'invalid_installments'; end if;
+
+  insert into public.event_registrations (event_id, lot_id, user_id, member_id, attendee_name, attendee_cpf, attendee_phone, attendee_email,
+                                          attendee_institution, attendee_religion, quantity, unit_price, total, installments, status, image_consent, image_consent_at)
+  values (_event, _lot, uid, m.id, m.full_name, nullif(d, ''), m.phone, coalesce(m.email, (select u.email from auth.users u where u.id = uid)),
+          v_institution, v_religion, _quantity, lt.price, total, n, case when pay_required then 'pending' else 'confirmed' end,
+          consent, case when consent then now() end)
+  returning id into reg;
+
+  if pay_required then
+    base := round(total / n, 2);
+    for i in 1..n loop
+      insert into public.event_payments (registration_id, installment_no, amount)
+      values (reg, i, case when i = n then total - base * (n - 1) else base end);
+    end loop;
+  else
+    perform public.issue_event_tickets(reg);
+  end if;
+  return reg;
+end $function$;
+
+revoke all on function public.register_for_event(uuid, uuid, integer, text, integer, boolean, text, text) from public, anon;
+grant execute on function public.register_for_event(uuid, uuid, integer, text, integer, boolean, text, text) to authenticated, service_role;
diff --git a/supabase/migrations/20261110010100_event_media.sql b/supabase/migrations/20261110010100_event_media.sql
new file mode 100644
index 0000000..611de78
--- /dev/null
+++ b/supabase/migrations/20261110010100_event_media.sql
@@ -0,0 +1,93 @@
+-- Mídia de divulgação do evento: uma foto, um vídeo (arquivo) ou um post do Instagram (link).
+-- Aparece como thumbnail do evento (landing, lista de eventos e painel) e acima da descrição na página de inscrição (só no computador).
+--
+-- media_type = 'image' | 'video'  -> media_path = caminho do arquivo no bucket público event-media
+-- media_type = 'instagram'        -> media_url  = link do post/reel (só instagram.com)
+-- Idempotente. A função public_events muda de assinatura (novas colunas), por isso é recriada.
+
+alter table public.events
+  add column if not exists media_type text,
+  add column if not exists media_path text,
+  add column if not exists media_url text;
+
+alter table public.events drop constraint if exists events_media_check;
+alter table public.events add constraint events_media_check check (
+  (media_type is null and media_path is null and media_url is null)
+  or (media_type in ('image', 'video') and media_path is not null and media_url is null)
+  or (media_type = 'instagram' and media_path is null
+      and media_url ~ '^https://(www\.)?instagram\.com/([A-Za-z0-9._]+/)?(p|reel|reels|tv)/[A-Za-z0-9_-]{5,}/?([?#].*)?$')
+);
+
+-- Bucket público: a foto/vídeo do evento é divulgação, qualquer visitante do site precisa ver.
+-- Só quem gerencia eventos envia arquivos. A exclusão passa pela lixeira de arquivos (storage_trash), como as demais.
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values ('event-media', 'event-media', true, 52428800,
+        array['image/jpeg', 'image/png', 'image/webp', 'video/mp4', 'video/webm', 'video/quicktime'])
+on conflict (id) do update
+  set public = true,
+      file_size_limit = excluded.file_size_limit,
+      allowed_mime_types = excluded.allowed_mime_types;
+
+drop policy if exists "event media insert" on storage.objects;
+create policy "event media insert" on storage.objects for insert to authenticated
+  with check (bucket_id = 'event-media' and public.has_permission(auth.uid(), 'manage_events'));
+
+-- Arquivo trocado ou evento excluído: o caminho antigo entra na lixeira de arquivos para ser apagado do armazenamento.
+drop trigger if exists trash_files on public.events;
+create trigger trash_files after delete or update of media_path on public.events
+  for each row execute function public.trash_file_trigger('event-media', 'media_path');
+
+-- O bucket novo entra nas funções que decidem se um arquivo ainda está em uso e na busca de arquivos sobrando.
+create or replace function public.storage_path_in_use(_bucket text, _path text)
+returns boolean language sql stable security definer set search_path = public as $$
+  select case _bucket
+    when 'member-photos' then exists (select 1 from public.members where photo_path = _path)
+    when 'receipts' then exists (select 1 from public.financial_transactions where receipt_path = _path)
+    when 'event-proofs' then exists (select 1 from public.event_payments where proof_path = _path)
+    when 'event-assets' then exists (select 1 from public.event_payment_info where pix_qr_path = _path)
+    when 'event-media' then exists (select 1 from public.events where media_path = _path)
+    when 'site-assets' then exists (select 1 from public.site_content where strpos(content::text, '/site-assets/' || _path) > 0)
+    else true
+  end;
+$$;
+
+create or replace function public.storage_orphans_preview()
+returns table (bucket text, path text, size bigint, created_at timestamptz)
+language plpgsql stable security definer set search_path = public as $$
+begin
+  if not public.is_church_leadership(auth.uid()) then raise exception 'Acesso negado'; end if;
+  return query
+    select o.bucket_id, o.name, coalesce((o.metadata ->> 'size')::bigint, 0), o.created_at
+    from storage.objects o
+    where o.bucket_id in ('member-photos', 'receipts', 'event-proofs', 'event-assets', 'event-media', 'site-assets')
+      and o.name not like '%.emptyFolderPlaceholder'
+      and o.created_at < now() - interval '1 day'
+      and not public.storage_path_in_use(o.bucket_id, o.name)
+    order by o.bucket_id, o.created_at;
+end $$;
+
+revoke all on function public.storage_path_in_use(text, text), public.storage_orphans_preview() from public, anon, authenticated;
+grant execute on function public.storage_orphans_preview() to authenticated;
+
+-- Lista pública de eventos agora devolve também a mídia (para a thumbnail).
+drop function if exists public.public_events();
+create function public.public_events()
+returns table (id uuid, slug text, title text, description text, location text, starts_at timestamptz, ends_at timestamptz,
+               registration_opens_at timestamptz, registration_closes_at timestamptz, audience text, payment_enabled boolean,
+               min_price numeric, spots_left int, registration_open boolean,
+               media_type text, media_path text, media_url text)
+language sql stable security definer set search_path = public as $$
+  select e.id, e.slug, e.title, e.description, e.location, e.starts_at, e.ends_at, e.registration_opens_at, e.registration_closes_at,
+         e.audience, e.payment_enabled,
+         (select min(l.price) from public.event_lots l where l.event_id = e.id),
+         case when exists (select 1 from public.event_lots l where l.event_id = e.id and l.capacity is null) then null
+              else (select coalesce(sum(greatest(l.capacity - public.lot_taken(l.id), 0)), 0)::int from public.event_lots l where l.event_id = e.id) end,
+         (coalesce(e.registration_opens_at, '-infinity') <= now() and coalesce(e.registration_closes_at, 'infinity') >= now()),
+         e.media_type, e.media_path, e.media_url
+  from public.events e
+  where e.published and coalesce(e.ends_at, e.starts_at) >= now() - interval '1 day'
+  order by e.starts_at;
+$$;
+
+revoke all on function public.public_events() from public;
+grant execute on function public.public_events() to anon, authenticated;
diff --git a/supabase/migrations/20261110010200_event_ticket_removal.sql b/supabase/migrations/20261110010200_event_ticket_removal.sql
new file mode 100644
index 0000000..424bef7
--- /dev/null
+++ b/supabase/migrations/20261110010200_event_ticket_removal.sql
@@ -0,0 +1,172 @@
+-- Remoção de ingressos (1 ou mais) de uma inscrição, sempre com uma observação explicando o motivo.
+--
+-- A observação fica registrada em event_ticket_removals e a pessoa inscrita a enxerga em "Meu cadastro".
+-- Regras (função remove_event_tickets):
+--   * Só quem gerencia eventos ou confere pagamentos pode remover (mesma regra de cancelar inscrição).
+--   * Inscrição com ingressos emitidos: escolhem-se os ingressos (têm que estar válidos; ingresso com presença confirmada
+--     não sai: desfaça a presença antes). Inscrição ainda sem ingressos (aguardando pagamento): informa-se a quantidade.
+--   * A quantidade e o total da inscrição diminuem, então as vagas do lote voltam a ficar disponíveis (lot_taken).
+--   * Removendo todos os ingressos, a inscrição inteira é cancelada (igual a "Cancelar inscrição", mas com observação).
+--   * Parcelas ainda não pagas são recalculadas para o novo total. Se o que já foi pago passa do novo total, as parcelas
+--     pendentes saem e o excedente fica registrado em refund_due (a devolução é feita pela igreja, fora do sistema).
+-- Idempotente.
+
+create table if not exists public.event_ticket_removals (
+  id uuid primary key default gen_random_uuid(),
+  event_id uuid not null references public.events(id) on delete cascade,
+  registration_id uuid not null references public.event_registrations(id) on delete cascade,
+  tickets_removed int not null check (tickets_removed >= 1),
+  holder_names text[] not null default '{}',
+  reason text not null check (char_length(btrim(reason)) between 3 and 500),
+  registration_cancelled boolean not null default false,
+  refund_due numeric(12,2) not null default 0,
+  removed_by uuid,
+  removed_at timestamptz not null default now()
+);
+create index if not exists event_ticket_removals_reg_idx on public.event_ticket_removals (registration_id);
+create index if not exists event_ticket_removals_event_idx on public.event_ticket_removals (event_id);
+
+alter table public.event_ticket_removals enable row level security;
+drop policy if exists "event_ticket_removals read" on public.event_ticket_removals;
+create policy "event_ticket_removals read" on public.event_ticket_removals for select to authenticated using (
+  public.has_any_event_permission(auth.uid())
+  or exists (select 1 from public.event_registrations r where r.id = registration_id and r.user_id = auth.uid()));
+revoke all on public.event_ticket_removals from anon, authenticated;
+grant select on public.event_ticket_removals to authenticated;
+
+alter table public.event_tickets
+  add column if not exists removal_id uuid references public.event_ticket_removals(id) on delete set null;
+
+create or replace function public.remove_event_tickets(
+  _reg uuid, _ticket_ids uuid[], _quantity integer, _reason text
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path to 'public'
+as $function$
+declare
+  uid uuid := auth.uid();
+  r public.event_registrations%rowtype;
+  v_reason text := regexp_replace(btrim(coalesce(_reason, '')), '\s+', ' ', 'g');
+  has_tickets boolean;
+  ids uuid[]; k int; found_n int;
+  names text[] := '{}';
+  new_qty int; new_total numeric; paid_sum numeric; due numeric; refund numeric;
+  unpaid uuid[]; unpaid_n int; base numeric; i int;
+  removal uuid; cancel_all boolean;
+begin
+  if uid is null then raise exception 'login_required'; end if;
+  if not (public.has_permission(uid, 'verify_event_payments') or public.has_permission(uid, 'manage_events')) then
+    raise exception 'Acesso negado';
+  end if;
+  if char_length(v_reason) < 3 or char_length(v_reason) > 500 then raise exception 'invalid_removal_reason'; end if;
+
+  select * into r from public.event_registrations where id = _reg for update;
+  if not found then raise exception 'not_found'; end if;
+  if r.status = 'cancelled' then raise exception 'registration_cancelled'; end if;
+
+  select exists (select 1 from public.event_tickets where registration_id = _reg) into has_tickets;
+
+  if has_tickets then
+    select coalesce(array_agg(distinct x), '{}') into ids from unnest(coalesce(_ticket_ids, '{}')) x;
+    k := coalesce(array_length(ids, 1), 0);
+    if k = 0 then raise exception 'invalid_removal_selection'; end if;
+    select count(*) into found_n from public.event_tickets t where t.registration_id = _reg and t.id = any (ids);
+    if found_n <> k then raise exception 'invalid_removal_selection'; end if;
+    if exists (select 1 from public.event_tickets t where t.id = any (ids) and t.status = 'checked_in') then
+      raise exception 'ticket_checked_in';
+    end if;
+    if exists (select 1 from public.event_tickets t where t.id = any (ids) and t.status <> 'valid') then
+      raise exception 'ticket_not_removable';
+    end if;
+    select coalesce(array_agg(t.holder_name order by t.seq), '{}') into names from public.event_tickets t where t.id = any (ids);
+  else
+    k := coalesce(_quantity, 0);
+  end if;
+  if k < 1 or k > r.quantity then raise exception 'invalid_removal_selection'; end if;
+
+  select coalesce(sum(p.amount), 0) into paid_sum from public.event_payments p where p.registration_id = _reg and p.status = 'paid';
+  cancel_all := k >= r.quantity;
+
+  insert into public.event_ticket_removals (event_id, registration_id, tickets_removed, holder_names, reason, registration_cancelled, removed_by)
+  values (r.event_id, _reg, k, names, v_reason, cancel_all, uid)
+  returning id into removal;
+
+  if has_tickets then
+    update public.event_tickets set status = 'cancelled', removal_id = removal where id = any (ids);
+  end if;
+
+  if cancel_all then
+    update public.event_registrations set status = 'cancelled', cancelled_at = now() where id = _reg;
+    update public.event_tickets set status = 'cancelled' where registration_id = _reg and status <> 'cancelled';
+    update public.event_payments set proof_path = null where registration_id = _reg and proof_path is not null;
+    new_qty := 0; new_total := 0;
+    refund := round(paid_sum, 2);
+  else
+    new_qty := r.quantity - k;
+    new_total := round(r.unit_price * new_qty, 2);
+    if exists (select 1 from public.event_payments where registration_id = _reg) then
+      if paid_sum >= new_total then
+        -- O que já foi pago cobre o novo total: parcelas ainda não avisadas saem. As "aguardando verificação" ficam
+        -- (a pessoa pode ter pago de verdade) para a equipe conferir ou devolver.
+        delete from public.event_payments where registration_id = _reg and status = 'pending';
+      else
+        select array_agg(p.id order by p.installment_no) into unpaid
+          from public.event_payments p where p.registration_id = _reg and p.status <> 'paid';
+        unpaid_n := coalesce(array_length(unpaid, 1), 0);
+        if unpaid_n > 0 then
+          due := new_total - paid_sum;
+          base := round(due / unpaid_n, 2);
+          for i in 1..unpaid_n loop
+            update public.event_payments
+               set amount = case when i = unpaid_n then due - base * (unpaid_n - 1) else base end
+             where id = unpaid[i];
+          end loop;
+        end if;
+      end if;
+    end if;
+    update public.event_registrations set quantity = new_qty, total = new_total where id = _reg;
+    refund := round(greatest(paid_sum - new_total, 0), 2);
+    -- Se sobraram só parcelas pagas, a inscrição que aguardava pagamento passa a estar quitada e o ingresso sai.
+    perform public.refresh_event_registration(_reg);
+  end if;
+
+  update public.event_ticket_removals set refund_due = refund where id = removal;
+
+  return jsonb_build_object('removed', k, 'registration_cancelled', cancel_all, 'new_quantity', new_qty,
+                            'new_total', new_total, 'paid', round(paid_sum, 2), 'refund_due', refund);
+end $function$;
+
+revoke all on function public.remove_event_tickets(uuid, uuid[], integer, text) from public, anon;
+grant execute on function public.remove_event_tickets(uuid, uuid[], integer, text) to authenticated, service_role;
+
+-- Resumo do evento: o "pago" de cada inscrição não passa do total dela (o excedente de quem teve ingresso removido
+-- aparece à parte, em refund_due_total), para o gráfico de pagamentos não ultrapassar 100%.
+create or replace function public.event_admin_stats(_event uuid)
+returns jsonb language plpgsql stable security definer set search_path = public as $$
+declare res jsonb;
+begin
+  if not public.has_any_event_permission(auth.uid()) then raise exception 'Acesso negado'; end if;
+  select jsonb_build_object(
+    'registrations', (select count(*) from public.event_registrations where event_id = _event and status <> 'cancelled'),
+    'tickets_total', (select count(*) from public.event_tickets where event_id = _event and status <> 'cancelled'),
+    'checked_in', (select count(*) from public.event_tickets where event_id = _event and status = 'checked_in'),
+    'expected_total', (select coalesce(sum(r.total), 0) from public.event_registrations r
+                         where r.event_id = _event and r.status <> 'cancelled' and exists (select 1 from public.event_payments p where p.registration_id = r.id)),
+    'paid_total', (select coalesce(sum(least(x.paid, x.total)), 0) from (
+                     select r.total, coalesce(sum(p.amount) filter (where p.status = 'paid'), 0) as paid
+                       from public.event_registrations r join public.event_payments p on p.registration_id = r.id
+                      where r.event_id = _event and r.status <> 'cancelled' group by r.id, r.total) x),
+    'refund_due_total', (select coalesce(sum(greatest(x.paid - x.total, 0)), 0) from (
+                     select r.total, coalesce(sum(p.amount) filter (where p.status = 'paid'), 0) as paid
+                       from public.event_registrations r join public.event_payments p on p.registration_id = r.id
+                      where r.event_id = _event and r.status <> 'cancelled' group by r.id, r.total) x),
+    'claimed_total', (select coalesce(sum(p.amount), 0) from public.event_payments p
+                        join public.event_registrations r on r.id = p.registration_id
+                        where r.event_id = _event and r.status <> 'cancelled' and p.status = 'claimed'),
+    'lots', coalesce((select jsonb_agg(jsonb_build_object('name', l.name, 'capacity', l.capacity, 'sold', public.lot_taken(l.id)) order by l.position, l.created_at)
+                        from public.event_lots l where l.event_id = _event), '[]'::jsonb)
+  ) into res;
+  return res;
+end $$;
