+      ref={ref}
+      src={src}
+      controls
+      autoPlay
+      muted
+      playsInline
+      preload="auto"
+      className="max-h-[28rem] w-full rounded-2xl border bg-black"
+      data-testid="event-video"
+    />
+  );
