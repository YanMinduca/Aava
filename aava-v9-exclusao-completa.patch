diff --git a/drizzle/migrations/0014_cascade_users_and_cleanup.sql b/drizzle/migrations/0014_cascade_users_and_cleanup.sql
new file mode 100644
index 0000000..5a111e9
--- /dev/null
+++ b/drizzle/migrations/0014_cascade_users_and_cleanup.sql
@@ -0,0 +1,88 @@
+-- Parte 1: limpa resíduos de usuários já apagados e liga as tabelas à de usuários (exclusão em cascata).
+-- Pode rodar mais de uma vez.
+
+-- 1) Resíduos de usuários que já não existem
+alter table public.members disable trigger members_guard;
+update public.members set user_id = null where user_id is not null and user_id not in (select id from auth.users);
+alter table public.members enable trigger members_guard;
+delete from public.user_roles where user_id not in (select id from auth.users);
+delete from public.user_permissions where user_id not in (select id from auth.users);
+delete from public.profiles where id not in (select id from auth.users);
+delete from public.member_claim_attempts where user_id not in (select id from auth.users);
+delete from public.prayer_requests where user_id is not null and user_id not in (select id from auth.users);
+delete from public.event_registrations where user_id not in (select id from auth.users);
+
+-- 2) Ligações: apagar o usuário apaga o que é dele (de qualquer lugar, inclusive do painel do Supabase)
+do $$
+begin
+  if not exists (select 1 from pg_constraint where conname = 'profiles_id_users_fkey') then
+    alter table public.profiles add constraint profiles_id_users_fkey foreign key (id) references auth.users(id) on delete cascade;
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'user_roles_user_users_fkey') then
+    alter table public.user_roles add constraint user_roles_user_users_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'user_permissions_user_users_fkey') then
+    alter table public.user_permissions add constraint user_permissions_user_users_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'member_claim_attempts_user_users_fkey') then
+    alter table public.member_claim_attempts add constraint member_claim_attempts_user_users_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'prayer_requests_user_users_fkey') then
+    alter table public.prayer_requests add constraint prayer_requests_user_users_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'event_registrations_user_users_fkey') then
+    alter table public.event_registrations add constraint event_registrations_user_users_fkey foreign key (user_id) references auth.users(id) on delete cascade;
+  end if;
+  -- O cadastro do membro é da igreja: ao apagar a conta, ele continua, só perde o vínculo.
+  if not exists (select 1 from pg_constraint where conname = 'members_user_users_fkey') then
+    alter table public.members add constraint members_user_users_fkey foreign key (user_id) references auth.users(id) on delete set null;
+  end if;
+end $$;
+
+-- 3) members_guard: libera SÓ o "soltar vínculo" feito pela própria ligação acima (gatilho dentro de gatilho)
+create or replace function public.members_guard()
+returns trigger language plpgsql security definer set search_path = public as $$
+begin
+  if tg_op = 'UPDATE' and pg_trigger_depth() > 1 and old.user_id is not null and new.user_id is null then
+    new.updated_at := now();
+    return new;
+  end if;
+  if tg_op = 'INSERT' and current_setting('app.event_visitor', true) = 'on'
+     and new.user_id = auth.uid() and new.status = 'visitante' then
+    new.approval_status := 'aprovado'; new.registration_number := null; new.church_role_id := null;
+    new.ministry := null; new.department := null; new.church_role := null; new.affiliated_on := null;
+    new.updated_at := now();
+    return new;
+  end if;
+  if tg_op = 'UPDATE'
+     and current_setting('app.claiming_member', true) = 'on'
+     and old.user_id is null and new.user_id = auth.uid() then
+    new.updated_at := now();
+    return new;
+  end if;
+  new.registration_number := nullif(btrim(new.registration_number), '');
+  if public.has_permission(auth.uid(), 'approve_member') or public.has_permission(auth.uid(), 'edit_member') or public.has_permission(auth.uid(), 'create_member') then
+    if not public.has_permission(auth.uid(), 'manage_departments') then
+      if tg_op = 'INSERT' then new.church_role_id := null;
+      else new.church_role_id := old.church_role_id; end if;
+    end if;
+    new.updated_at := now();
+    return new;
+  end if;
+  if tg_op = 'INSERT' then
+    new.approval_status := 'pendente';
+    new.status := 'membro';
+    new.ministry := null; new.department := null; new.church_role := null; new.church_role_id := null;
+    new.affiliated_on := null;
+    new.registration_number := null;
+  else
+    new.approval_status := case when old.approval_status = 'recusado' then 'pendente' else old.approval_status end;
+    new.status := old.status;
+    new.ministry := old.ministry; new.department := old.department; new.church_role := old.church_role; new.church_role_id := old.church_role_id;
+    new.affiliated_on := old.affiliated_on;
+    new.registration_number := old.registration_number;
+    new.user_id := old.user_id;
+  end if;
+  new.updated_at := now();
+  return new;
+end $$;
diff --git a/drizzle/migrations/0015_storage_trash.sql b/drizzle/migrations/0015_storage_trash.sql
new file mode 100644
index 0000000..ea3fae3
--- /dev/null
+++ b/drizzle/migrations/0015_storage_trash.sql
@@ -0,0 +1,139 @@
+-- Parte 2: "lixeira" de arquivos. Ao apagar (ou trocar) uma linha que aponta para um arquivo do armazenamento,
+-- o banco anota o arquivo aqui; o painel então apaga o arquivo de verdade (SQL não pode apagar arquivos do storage).
+-- Pode rodar mais de uma vez.
+
+create table if not exists public.storage_trash (
+  id bigint generated always as identity primary key,
+  bucket text not null,
+  path text not null,
+  created_at timestamptz not null default now(),
+  unique (bucket, path)
+);
+alter table public.storage_trash enable row level security;
+revoke all on public.storage_trash from anon, authenticated;
+
+create or replace function public.enqueue_storage_trash(_bucket text, _path text)
+returns void language sql security definer set search_path = public as $$
+  insert into public.storage_trash (bucket, path)
+  select _bucket, _path where coalesce(btrim(_path), '') <> ''
+  on conflict (bucket, path) do nothing;
+$$;
+
+create or replace function public.trash_file_trigger()
+returns trigger language plpgsql security definer set search_path = public as $$
+declare b text := tg_argv[0]; col text := tg_argv[1]; old_path text; new_path text;
+begin
+  old_path := to_jsonb(old) ->> col;
+  if tg_op = 'DELETE' then
+    perform public.enqueue_storage_trash(b, old_path);
+    return old;
+  end if;
+  new_path := to_jsonb(new) ->> col;
+  if old_path is not null and old_path is distinct from new_path then
+    perform public.enqueue_storage_trash(b, old_path);
+  end if;
+  return new;
+end $$;
+
+drop trigger if exists trash_files on public.event_payments;
+create trigger trash_files after delete or update of proof_path on public.event_payments
+  for each row execute function public.trash_file_trigger('event-proofs', 'proof_path');
+drop trigger if exists trash_files on public.event_payment_info;
+create trigger trash_files after delete or update of pix_qr_path on public.event_payment_info
+  for each row execute function public.trash_file_trigger('event-assets', 'pix_qr_path');
+drop trigger if exists trash_files on public.members;
+create trigger trash_files after delete or update of photo_path on public.members
+  for each row execute function public.trash_file_trigger('member-photos', 'photo_path');
+drop trigger if exists trash_files on public.financial_transactions;
+create trigger trash_files after delete or update of receipt_path on public.financial_transactions
+  for each row execute function public.trash_file_trigger('receipts', 'receipt_path');
+
+-- Um arquivo ainda em uso nunca é apagado (bucket desconhecido conta como "em uso")
+create or replace function public.storage_path_in_use(_bucket text, _path text)
+returns boolean language sql stable security definer set search_path = public as $$
+  select case _bucket
+    when 'member-photos' then exists (select 1 from public.members where photo_path = _path)
+    when 'receipts' then exists (select 1 from public.financial_transactions where receipt_path = _path)
+    when 'event-proofs' then exists (select 1 from public.event_payments where proof_path = _path)
+    when 'event-assets' then exists (select 1 from public.event_payment_info where pix_qr_path = _path)
+    when 'site-assets' then exists (select 1 from public.site_content where strpos(content::text, '/site-assets/' || _path) > 0)
+    else true
+  end;
+$$;
+
+-- Quem pode esvaziar a lixeira inteira: CEO/Pastor Presidente e quem tem alguma permissão liberada; os demais, só a própria pasta
+create or replace function public.can_purge_storage(_user_id uuid)
+returns boolean language sql stable security definer set search_path = public as $$
+  select _user_id is not null and (
+    public.is_church_leadership(_user_id) or exists (select 1 from public.user_permissions where user_id = _user_id));
+$$;
+
+create or replace function public.storage_trash_next(_limit int default 100)
+returns table (id bigint, bucket text, path text)
+language plpgsql security definer set search_path = public as $$
+begin
+  if auth.uid() is null then return; end if;
+  delete from public.storage_trash t where public.storage_path_in_use(t.bucket, t.path);
+  return query
+    select t.id, t.bucket, t.path from public.storage_trash t
+    where public.can_purge_storage(auth.uid()) or t.path like auth.uid()::text || '/%'
+    order by t.id limit greatest(1, least(coalesce(_limit, 100), 500));
+end $$;
+
+create or replace function public.storage_trash_done(_ids bigint[])
+returns void language plpgsql security definer set search_path = public as $$
+begin
+  if auth.uid() is null then return; end if;
+  delete from public.storage_trash t
+   where t.id = any (_ids) and (public.can_purge_storage(auth.uid()) or t.path like auth.uid()::text || '/%');
+end $$;
+
+-- Regras do armazenamento: só dá para ler/apagar objeto que está na lixeira (e não está em uso)
+create or replace function public.storage_trash_allows(_bucket text, _name text)
+returns boolean language sql stable security definer set search_path = public as $$
+  select auth.uid() is not null
+     and exists (select 1 from public.storage_trash t where t.bucket = _bucket and t.path = _name)
+     and (public.can_purge_storage(auth.uid()) or _name like auth.uid()::text || '/%')
+     and not public.storage_path_in_use(_bucket, _name);
+$$;
+
+drop policy if exists "trash select" on storage.objects;
+create policy "trash select" on storage.objects for select to authenticated using (public.storage_trash_allows(bucket_id, name));
+drop policy if exists "trash delete" on storage.objects;
+create policy "trash delete" on storage.objects for delete to authenticated using (public.storage_trash_allows(bucket_id, name));
+
+-- Arquivos sem nenhum registro apontando para eles (mais de 1 dia, para não pegar envio em andamento)
+create or replace function public.storage_orphans_preview()
+returns table (bucket text, path text, size bigint, created_at timestamptz)
+language plpgsql stable security definer set search_path = public as $$
+begin
+  if not public.is_church_leadership(auth.uid()) then raise exception 'Acesso negado'; end if;
+  return query
+    select o.bucket_id, o.name, coalesce((o.metadata ->> 'size')::bigint, 0), o.created_at
+    from storage.objects o
+    where o.bucket_id in ('member-photos', 'receipts', 'event-proofs', 'event-assets', 'site-assets')
+      and o.name not like '%.emptyFolderPlaceholder'
+      and o.created_at < now() - interval '1 day'
+      and not public.storage_path_in_use(o.bucket_id, o.name)
+    order by o.bucket_id, o.created_at;
+end $$;
+
+create or replace function public.storage_enqueue_orphans()
+returns int language plpgsql security definer set search_path = public as $$
+declare n int;
+begin
+  if not public.is_church_leadership(auth.uid()) then raise exception 'Acesso negado'; end if;
+  with ins as (
+    insert into public.storage_trash (bucket, path)
+    select p.bucket, p.path from public.storage_orphans_preview() p
+    on conflict (bucket, path) do nothing
+    returning 1)
+  select count(*) into n from ins;
+  return n;
+end $$;
+
+revoke all on function public.enqueue_storage_trash(text, text), public.trash_file_trigger(), public.storage_path_in_use(text, text),
+  public.can_purge_storage(uuid), public.storage_trash_next(int), public.storage_trash_done(bigint[]), public.storage_trash_allows(text, text),
+  public.storage_orphans_preview(), public.storage_enqueue_orphans() from public, anon, authenticated;
+grant execute on function public.storage_trash_next(int), public.storage_trash_done(bigint[]), public.storage_trash_allows(text, text),
+  public.storage_orphans_preview(), public.storage_enqueue_orphans() to authenticated;
diff --git a/drizzle/migrations/0016_delete_user_cancel_proofs_dashboard.sql b/drizzle/migrations/0016_delete_user_cancel_proofs_dashboard.sql
new file mode 100644
index 0000000..a6f6b3a
--- /dev/null
+++ b/drizzle/migrations/0016_delete_user_cancel_proofs_dashboard.sql
@@ -0,0 +1,52 @@
+-- Parte 3: excluir usuário (CEO/Pastor Presidente), comprovantes apagados ao cancelar inscrição,
+-- e números de voluntários/departamentos só para quem tem permissão de departamentos. Pode rodar mais de uma vez.
+
+-- Excluir a conta de um usuário. O cadastro de membro continua (sem vínculo), a menos que se peça para apagar também.
+-- Tudo o que é da pessoa (perfil, papéis, permissões, pedidos de oração, inscrições, pagamentos, ingressos, comprovantes) vai junto.
+create or replace function public.delete_user_account(_user uuid, _delete_member boolean default false)
+returns void language plpgsql security definer set search_path = public as $$
+declare uid uuid := auth.uid();
+begin
+  if not public.is_church_leadership(uid) then raise exception 'Acesso negado'; end if;
+  if _user = uid then raise exception 'cannot_delete_self'; end if;
+  if not exists (select 1 from auth.users where id = _user) then raise exception 'user_not_found'; end if;
+  if public.has_role(_user, 'ceo') then raise exception 'cannot_delete_ceo'; end if;
+  if public.has_role(_user, 'pastor_presidente') and not public.has_role(uid, 'ceo') then raise exception 'only_ceo_deletes_president'; end if;
+  if _delete_member then
+    delete from public.members where user_id = _user;
+  end if;
+  delete from auth.users where id = _user;
+end $$;
+revoke all on function public.delete_user_account(uuid, boolean) from public, anon;
+grant execute on function public.delete_user_account(uuid, boolean) to authenticated;
+
+-- Cancelar inscrição apaga os comprovantes (o arquivo vai para a lixeira e é removido do armazenamento)
+create or replace function public.cancel_event_registration(_reg uuid)
+returns void language plpgsql security definer set search_path = public as $$
+declare uid uuid := auth.uid(); r public.event_registrations%rowtype; staff boolean;
+begin
+  if uid is null then raise exception 'login_required'; end if;
+  select * into r from public.event_registrations where id = _reg;
+  if not found then raise exception 'not_found'; end if;
+  staff := public.has_permission(uid, 'verify_event_payments') or public.has_permission(uid, 'manage_events');
+  if not staff then
+    if r.user_id <> uid then raise exception 'Acesso negado'; end if;
+    if r.status <> 'pending' or exists (select 1 from public.event_payments p where p.registration_id = _reg and p.status in ('claimed', 'paid')) then
+      raise exception 'cannot_cancel';
+    end if;
+  end if;
+  if r.status = 'cancelled' then return; end if;
+  update public.event_registrations set status = 'cancelled', cancelled_at = now() where id = _reg;
+  update public.event_tickets set status = 'cancelled' where registration_id = _reg;
+  update public.event_payments set proof_path = null where registration_id = _reg and proof_path is not null;
+end $$;
+
+-- Dashboard: voluntários e departamentos só para quem tem a permissão de departamentos (não para membro comum)
+create or replace function public.dashboard_volunteer_stats()
+returns jsonb language sql stable security definer set search_path = public as $$
+  select jsonb_build_object('departments', count(distinct d.id), 'volunteers', count(distinct dm.member_id))
+  from public.departments d
+  left join public.department_members dm on dm.department_id = d.id
+  where (public.has_permission(auth.uid(), 'view_departments') or public.has_permission(auth.uid(), 'manage_departments'))
+    and public.can_view_department(auth.uid(), d.id);
+$$;
