diff --git a/src/components/members/CpfSignupNotice.tsx b/src/components/members/CpfSignupNotice.tsx
new file mode 100644
index 0000000..e179e6d
--- /dev/null
+++ b/src/components/members/CpfSignupNotice.tsx
@@ -0,0 +1,99 @@
+import { useEffect, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { toast } from "sonner";
+import { ShieldAlert } from "lucide-react";
+import { supabase } from "@/integrations/supabase/client";
+import { Button } from "@/components/ui/button";
+import { CLAIM_MESSAGES } from "@/components/members/ClaimSuggestion";
+import { useDebounced } from "@/lib/use-debounced";
+
+/**
+ * Para quem está criando o próprio cadastro: se o CPF digitado já existe no banco, não deixa criar um novo
+ * cadastro; só oferece vincular a conta ao cadastro que já existe. (O banco também barra o CPF repetido.)
+ */
+export function CpfSignupNotice({
+  cpf,
+  canClaim,
+  onBlockChange,
+  onClaimed,
+}: {
+  cpf: string;
+  /** Falso quando a conta já tem cadastro próprio (aí não há o que vincular). */
+  canClaim: boolean;
+  onBlockChange: (blocked: boolean) => void;
+  onClaimed: () => void;
+}) {
+  const digits = cpf.replace(/\D/g, "");
+  const settled = useDebounced(digits, 500);
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState("");
+
+  const q = useQuery({
+    queryKey: ["cpf-signup", settled],
+    enabled: settled.length === 11,
+    staleTime: 30_000,
+    retry: false,
+    queryFn: async () => {
+      const { data, error } = await supabase.rpc("check_cpf_for_signup", { _cpf: settled });
+      if (error) throw error;
+      return data?.[0] ?? null;
+    },
+  });
+
+  const hit = settled.length === 11 && digits === settled ? (q.data ?? null) : null;
+  const blocked = !!hit && hit.state !== "limited";
+  useEffect(() => onBlockChange(blocked), [blocked, onBlockChange]);
+  useEffect(() => setNotice(""), [settled]);
+
+  if (!hit) return null;
+
+  async function claim() {
+    if (!hit?.id) return;
+    setBusy(true);
+    const { data, error } = await supabase.rpc("claim_member", { _member: hit.id, _cpf: cpf });
+    setBusy(false);
+    if (error) {
+      toast.error(error.message);
+      return;
+    }
+    if (data === "ok") {
+      toast.success("Pronto! Sua conta foi vinculada ao cadastro que já existia.");
+      onClaimed();
+      return;
+    }
+    setNotice(CLAIM_MESSAGES[data ?? ""] ?? "Não foi possível vincular agora.");
+  }
+
+  if (hit.state === "limited") {
+    return (
+      <p className="mt-2 text-xs text-muted-foreground">
+        Muitas consultas seguidas. Se este CPF já tiver cadastro na igreja, o sistema vai avisar ao enviar.
+      </p>
+    );
+  }
+
+  const claimable = hit.state === "claimable" && canClaim;
+  return (
+    <div role="alert" className="mt-2 rounded-xl border border-destructive/40 bg-destructive/5 p-4 text-sm">
+      <p className="flex items-start gap-2 font-medium text-foreground">
+        <ShieldAlert className="mt-0.5 h-4 w-4 shrink-0 text-destructive" aria-hidden />
+        <span>
+          {claimable
+            ? <>Já existe um cadastro com este CPF{hit.masked_name ? <> (<strong>{hit.masked_name}</strong>)</> : null}. Para não duplicar, não é possível criar outro cadastro com ele.</>
+            : hit.state === "in_use"
+              ? "Este CPF já está vinculado a outra conta. Se é o seu, procure a secretaria da igreja."
+              : "Este CPF já consta em outro cadastro. Procure a secretaria da igreja para resolver."}
+        </span>
+      </p>
+      {claimable && (
+        <div className="mt-3">
+          <Button type="button" size="sm" disabled={busy} onClick={claim}>
+            Este cadastro é meu — vincular minha conta
+          </Button>
+          <p className="mt-2 text-xs text-muted-foreground">Seus dados ficam como a igreja já tem; depois você pode atualizá-los em “Meu cadastro”.</p>
+        </div>
+      )}
+      {notice && <p className="mt-3 text-destructive">{notice}</p>}
+    </div>
+  );
+}
diff --git a/src/components/members/MemberDuplicateAlert.tsx b/src/components/members/MemberDuplicateAlert.tsx
new file mode 100644
index 0000000..9c8c0ce
--- /dev/null
+++ b/src/components/members/MemberDuplicateAlert.tsx
@@ -0,0 +1,95 @@
+import { Link } from "@tanstack/react-router";
+import { useQuery } from "@tanstack/react-query";
+import { AlertTriangle } from "lucide-react";
+import { supabase } from "@/integrations/supabase/client";
+import { Badge } from "@/components/ui/badge";
+import { MEMBER_STATUS } from "@/lib/church";
+import { useDebounced } from "@/lib/use-debounced";
+
+/**
+ * Aviso para quem cadastra/edita membros: mostra se já existe alguém com o mesmo nome, CPF ou RG.
+ * Um CPF repetido é bloqueado pelo banco ao salvar; nome e RG repetidos são só um aviso (pode ser homônimo).
+ */
+export function MemberDuplicateAlert({
+  name,
+  cpf,
+  rg,
+  excludeId,
+  className = "",
+}: {
+  name?: string | null | undefined;
+  cpf?: string | null | undefined;
+  rg?: string | null | undefined;
+  /** Cadastro que está sendo editado (não conta como duplicado de si mesmo). */
+  excludeId?: string | null | undefined;
+  className?: string;
+}) {
+  const typed = useDebounced(JSON.stringify([name ?? "", cpf ?? "", rg ?? ""]));
+  const [n = "", c = "", r = ""] = JSON.parse(typed) as string[];
+  const enabled =
+    n.trim().split(/\s+/).filter(Boolean).length >= 2 ||
+    c.replace(/\D/g, "").length === 11 ||
+    r.replace(/[^0-9a-z]/gi, "").length >= 5;
+
+  const q = useQuery({
+    queryKey: ["member-duplicates", n, c, r, excludeId ?? null],
+    enabled,
+    staleTime: 15_000,
+    retry: false,
+    queryFn: async () => {
+      const { data, error } = await supabase.rpc("find_member_duplicates", {
+        _name: n,
+        _cpf: c,
+        _rg: r,
+        ...(excludeId ? { _exclude: excludeId } : {}),
+      });
+      if (error) throw error;
+      return data ?? [];
+    },
+  });
+
+  const rows = enabled ? (q.data ?? []) : [];
+  if (rows.length === 0) return null;
+  const cpfTaken = rows.some((d) => d.match_cpf);
+
+  return (
+    <div
+      role="alert"
+      className={`rounded-xl border p-4 text-sm ${cpfTaken ? "border-destructive/40 bg-destructive/5" : "border-primary/30 bg-primary-soft"} ${className}`}
+    >
+      <p className="flex items-start gap-2 font-medium text-foreground">
+        <AlertTriangle className={`mt-0.5 h-4 w-4 shrink-0 ${cpfTaken ? "text-destructive" : "text-primary"}`} aria-hidden />
+        {cpfTaken
+          ? "Este CPF já está cadastrado. Não é possível salvar outro cadastro com ele."
+          : "Já existe cadastro parecido. Confira antes de salvar para não duplicar o membro."}
+      </p>
+      <ul className="mt-3 space-y-2">
+        {rows.map((d) => (
+          <li key={d.id} className="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border bg-background px-3 py-2">
+            <span className="font-medium text-foreground">{d.full_name}</span>
+            <span className="text-xs text-muted-foreground">
+              {d.registration_number ? `Matrícula ${d.registration_number} · ` : ""}
+              {MEMBER_STATUS[d.status] ?? d.status}
+              {d.approval_status !== "aprovado" ? " · aguardando aprovação" : ""}
+              {d.has_account ? " · já tem conta" : ""}
+            </span>
+            <span className="flex flex-wrap gap-1">
+              {d.match_cpf && <Badge variant="destructive">mesmo CPF</Badge>}
+              {d.match_rg && <Badge variant="secondary">mesmo RG</Badge>}
+              {d.match_name && <Badge variant="secondary">mesmo nome</Badge>}
+            </span>
+            <Link
+              to="/painel/membro/$id"
+              params={{ id: d.id }}
+              target="_blank"
+              rel="noreferrer"
+              className="ml-auto text-xs text-primary underline"
+            >
+              Abrir cadastro
+            </Link>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
