+                : []),
+              <span key="pg">
+                Pela página{" "}
+                <a className="text-primary underline" href="/contato">
+                  Contato
+                </a>
+                , ou pessoalmente em {c.address}, {c.city}.
+              </span>,
+            ]}
+          />
+        </Section>
+      </article>
+    </SiteLayout>
+  );
+}
