+                    <RadioGroupItem value={l.id} disabled={!!blocked} />
+                    <span>
+                      <span className="block font-medium text-foreground">{l.name}</span>
+                      <span className="block text-xs text-muted-foreground">
+                        {l.spots_left === null ? "Vagas ilimitadas" : `${l.spots_left} vagas restantes`}
+                        {l.closes_at ? ` · até ${fmtDate(l.closes_at)}` : ""}
+                      </span>
+                    </span>
+                  </span>
+                  <span className="text-right">
+                    <span className="block font-semibold text-foreground">{event.payment_enabled && l.price > 0 ? moneyBR(l.price) : "Gratuito"}</span>
+                    {blocked && <Badge variant="secondary">{blocked}</Badge>}
+                  </span>
+                </label>
+              );
+            })}
+          </RadioGroup>
+        </div>
+
+        <div className="grid gap-4 sm:grid-cols-2">
+          <div className="space-y-1.5">
+            <Label>Quantidade de ingressos</Label>
+            <Input type="number" min={1} max={maxQty} value={qty} onChange={(e) => setQty(Math.max(1, Math.min(maxQty, Number(e.target.value) || 1)))} />
+            {event.limit_per_person && <p className="text-xs text-muted-foreground">Limite de {event.max_per_person} por pessoa (controlado pelo CPF).</p>}
+          </div>
+          <div className="space-y-1.5">
+            <Label>CPF{event.limit_per_person ? " *" : " (opcional)"}</Label>
+            <Input inputMode="numeric" placeholder="000.000.000-00" required={event.limit_per_person} value={cpf} onChange={(e) => setCpf(formatCpf(e.target.value))} />
+          </div>
+        </div>
+
+        {payRequired && event.allow_installments && event.max_installments > 1 && (
+          <div className="space-y-1.5">
+            <Label>Forma de pagamento (Pix)</Label>
+            <Select value={String(installments)} onValueChange={(v) => setInstallments(Number(v))}>
+              <SelectTrigger><SelectValue /></SelectTrigger>
+              <SelectContent>
+                {Array.from({ length: event.max_installments }, (_, i) => i + 1).map((n) => (
+                  <SelectItem key={n} value={String(n)}>
+                    {n === 1 ? `À vista — ${moneyBR(total)}` : `${n}x de ${moneyBR(total / n)}`}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+          </div>
+        )}
+
+        <div className="flex flex-wrap items-center justify-between gap-3 border-t pt-4">
+          <p className="text-sm text-muted-foreground">
+            Total: <strong className="text-lg text-foreground">{payRequired ? moneyBR(total) : "Gratuito"}</strong>
+          </p>
+          <Button type="submit" size="lg" disabled={register.isPending || !lotId}>Inscrever-se</Button>
+        </div>
+      </form>
+    </Box>
+  );
+}
diff --git a/src/components/events/EventsList.tsx b/src/components/events/EventsList.tsx
new file mode 100644
index 0000000..dd7ba6f
--- /dev/null
+++ b/src/components/events/EventsList.tsx
@@ -0,0 +1,98 @@
+import { Link } from "@tanstack/react-router";
+import { useQuery } from "@tanstack/react-query";
+import { ArrowUpRight, CalendarDays, MapPin, Ticket, Users } from "lucide-react";
+import { supabase } from "@/integrations/supabase/client";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { fmtDate, fmtLongDate, fmtTime, moneyBR } from "@/lib/events";
+import type { Database } from "@/integrations/supabase/types";
+
+type EventRow = Database["public"]["Functions"]["public_events"]["Returns"][number];
+
+export function usePublicEvents() {
+  return useQuery({
+    queryKey: ["public-events"],
+    queryFn: async () => {
+      const { data, error } = await supabase.rpc("public_events");
+      if (error) throw error;
+      return data ?? [];
+    },
+  });
+}
+
+function registrationLabel(e: EventRow) {
+  const now = new Date();
+  if (e.registration_opens_at && new Date(e.registration_opens_at) > now) return `Inscrições a partir de ${fmtDate(e.registration_opens_at)}`;
+  if (e.registration_closes_at && new Date(e.registration_closes_at) < now) return "Inscrições encerradas";
+  if (e.spots_left === 0) return "Vagas esgotadas";
+  return e.registration_closes_at ? `Inscrições até ${fmtDate(e.registration_closes_at)}` : "Inscrições abertas";
+}
+
+export function EventCard({ e }: { e: EventRow }) {
+  const open = e.registration_open && e.spots_left !== 0;
+  return (
+    <Link
+      to="/eventos/$slug"
+      params={{ slug: e.slug }}
+      className="group flex flex-col rounded-2xl border bg-card p-6 transition-colors hover:border-primary"
+    >
+      <div className="flex flex-wrap items-center gap-2">
+        <Badge variant={open ? "default" : "secondary"}>{registrationLabel(e)}</Badge>
+        {e.audience === "members" && <Badge variant="outline">Para membros</Badge>}
+      </div>
+      <h3 className="mt-4 text-xl text-foreground">{e.title}</h3>
+      <p className="mt-3 flex items-center gap-2 text-sm text-muted-foreground">
+        <CalendarDays className="h-4 w-4 shrink-0" />
+        <span className="capitalize">{fmtLongDate(e.starts_at)}</span> · {fmtTime(e.starts_at)}
+      </p>
+      {e.location && (
+        <p className="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
+          <MapPin className="h-4 w-4 shrink-0" /> {e.location}
+        </p>
+      )}
+      <div className="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-foreground">
+        <span className="inline-flex items-center gap-1.5">
+          <Ticket className="h-4 w-4 text-primary" />
+          {!e.payment_enabled || !e.min_price ? "Gratuito" : `A partir de ${moneyBR(e.min_price)}`}
+        </span>
+        {e.spots_left !== null && (
+          <span className="inline-flex items-center gap-1.5">
+            <Users className="h-4 w-4 text-primary" /> {e.spots_left === 0 ? "Esgotado" : `${e.spots_left} vagas`}
+          </span>
+        )}
+      </div>
+      <span className="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
+        Ver detalhes <ArrowUpRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
+      </span>
+    </Link>
+  );
+}
+
+/** Seção da landing page: próximos eventos. Some sozinha se não houver nenhum evento publicado. */
+export function EventsSection() {
+  const { data = [] } = usePublicEvents();
+  if (data.length === 0) return null;
+  const shown = data.slice(0, 3);
+  return (
+    <section className="mx-auto max-w-7xl px-5 py-16 lg:px-10" id="eventos">
+      <div className="mb-8 flex flex-wrap items-end justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold text-primary">AGENDA</p>
+          <h2 className="mt-2 text-3xl">Eventos</h2>
+        </div>
+        {data.length > shown.length && (
+          <Button asChild variant="outline">
+            <Link to="/eventos">
+              Ver todos os eventos <ArrowUpRight />
+            </Link>
+          </Button>
+        )}
+      </div>
+      <div className="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
+        {shown.map((e) => (
+          <EventCard key={e.id} e={e} />
+        ))}
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/events/MyTickets.tsx b/src/components/events/MyTickets.tsx
new file mode 100644
index 0000000..95f06f8
--- /dev/null
+++ b/src/components/events/MyTickets.tsx
@@ -0,0 +1,220 @@
+import { useEffect, useRef, useState } from "react";
+import { Link } from "@tanstack/react-router";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import QRCode from "qrcode";
+import { toast } from "sonner";
+import { CalendarDays, Copy, Download, ExternalLink, Upload } from "lucide-react";
+import { supabase } from "@/integrations/supabase/client";
+import { safeLink } from "@/lib/site-content";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { eventError, fmtDateTime, moneyBR, PAYMENT_STATUS, REGISTRATION_STATUS, TICKET_STATUS } from "@/lib/events";
+
+function TicketQr({ code, name }: { code: string; name: string }) {
+  const [url, setUrl] = useState("");
+  useEffect(() => {
+    QRCode.toDataURL(code, { width: 280, margin: 1, errorCorrectionLevel: "M" }).then(setUrl);
+  }, [code]);
+  if (!url) return <div className="h-44 w-44 animate-pulse rounded-lg bg-muted" />;
+  return (
+    <div className="flex flex-col items-center gap-2">
+      <img src={url} alt={`QR code do ingresso de ${name}`} className="h-44 w-44 rounded-lg border bg-white p-1" />
+      <a href={url} download={`ingresso-${name.replace(/\s+/g, "-").toLowerCase()}.png`} className="inline-flex items-center gap-1 text-xs text-primary underline">
+        <Download className="h-3 w-3" /> Salvar imagem
+      </a>
+    </div>
+  );
+}
+
+function PaymentInstructions({ eventId }: { eventId: string }) {
+  const info = useQuery({
+    queryKey: ["event-payment-info", eventId],
+    queryFn: async () => (await supabase.from("event_payment_info").select("*").eq("event_id", eventId).maybeSingle()).data,
+  });
+  const qr = useQuery({
+    queryKey: ["event-qr", info.data?.pix_qr_path],
+    enabled: !!info.data?.pix_qr_path,
+    queryFn: async () => (await supabase.storage.from("event-assets").createSignedUrl(info.data!.pix_qr_path!, 3600)).data?.signedUrl ?? null,
+  });
+  const d = info.data;
+  if (!d) return null;
+  const link = d.payment_link ? safeLink(d.payment_link) : "";
+  return (
+    <div className="rounded-xl border bg-primary-soft p-4 text-sm">
+      <p className="font-medium text-foreground">Como pagar</p>
+      <div className="mt-3 flex flex-wrap items-start gap-6">
+        {qr.data && <img src={qr.data} alt="QR code do pagamento" className="h-40 w-40 rounded-lg border bg-white p-1" />}
+        <div className="space-y-3">
+          {link && (
+            <Button asChild size="sm"><a href={link} target="_blank" rel="noreferrer noopener"><ExternalLink className="h-4 w-4" /> Pagar pelo link</a></Button>
+          )}
+          {d.pix_key && (
+            <div>
+              <p className="text-xs text-muted-foreground">Chave Pix</p>
+              <p className="flex items-center gap-2 break-all font-mono text-foreground">
+                {d.pix_key}
+                <Button type="button" size="icon" variant="ghost" aria-label="Copiar chave Pix" onClick={() => navigator.clipboard.writeText(d.pix_key!).then(() => toast.success("Chave Pix copiada"))}><Copy className="h-4 w-4" /></Button>
+              </p>
+            </div>
+          )}
+          {d.card_contact_note && <p className="max-w-xs text-muted-foreground">{d.card_contact_note}</p>}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export function MyTickets({ uid }: { uid: string }) {
+  const qc = useQueryClient();
+  const fileRef = useRef<HTMLInputElement>(null);
+  const [uploadFor, setUploadFor] = useState<string | null>(null);
+
+  const regs = useQuery({
+    queryKey: ["my-registrations", uid],
+    queryFn: async () => {
+      const { data, error } = await supabase
+        .from("event_registrations")
+        .select("*, events(title, slug, starts_at, location), event_lots(name), event_payments(*), event_tickets(*)")
+        .eq("user_id", uid)
+        .order("created_at", { ascending: false });
+      if (error) throw error;
+      return data ?? [];
+    },
+  });
+  const refresh = () => qc.invalidateQueries({ queryKey: ["my-registrations", uid] });
+
+  const claim = useMutation({
+    mutationFn: async ({ paymentId, proofPath }: { paymentId: string; proofPath?: string }) => {
+      const { error } = await supabase.rpc("claim_event_payment", proofPath ? { _payment: paymentId, _proof_path: proofPath } : { _payment: paymentId });
+      if (error) throw error;
+    },
+    onSuccess: () => {
+      toast.success("Pronto! A igreja vai conferir o pagamento.");
+      refresh();
+    },
+    onError: (e) => toast.error(eventError(e)),
+  });
+
+  const cancel = useMutation({
+    mutationFn: async (id: string) => {
+      const { error } = await supabase.rpc("cancel_event_registration", { _reg: id });
+      if (error) throw error;
+    },
+    onSuccess: () => {
+      toast.success("Inscrição cancelada");
+      refresh();
+      qc.invalidateQueries({ queryKey: ["public-events"] });
+    },
+    onError: (e) => toast.error(eventError(e)),
+  });
+
+  async function onFile(file: File | undefined) {
+    const paymentId = uploadFor;
+    setUploadFor(null);
+    if (!file || !paymentId) return;
+    if (file.size > 8 * 1024 * 1024) {
+      toast.error("O arquivo deve ter até 8 MB.");
+      return;
+    }
+    const ext = (file.name.split(".").pop() ?? "jpg").toLowerCase().replace(/[^a-z0-9]/g, "");
+    const path = `${uid}/${paymentId}-${Date.now()}.${ext || "jpg"}`;
+    const { error } = await supabase.storage.from("event-proofs").upload(path, file);
+    if (error) {
+      toast.error("Não foi possível enviar o comprovante.");
+      return;
+    }
+    claim.mutate({ paymentId, proofPath: path });
+  }
+
+  async function openProof(path: string) {
+    const { data } = await supabase.storage.from("event-proofs").createSignedUrl(path, 300);
+    if (data?.signedUrl) window.open(data.signedUrl, "_blank", "noopener");
+  }
+
+  const list = regs.data ?? [];
+  if (list.length === 0) return null;
+
+  return (
+    <section id="ingressos" className="mt-12">
+      <h2 className="text-2xl text-foreground">Meus ingressos</h2>
+      <input ref={fileRef} type="file" accept="image/*,application/pdf" className="hidden" onChange={(e) => { onFile(e.target.files?.[0]); e.target.value = ""; }} />
+      <div className="mt-5 space-y-6">
+        {list.map((r) => {
+          const payments = [...(r.event_payments ?? [])].sort((a, b) => a.installment_no - b.installment_no);
+          const tickets = [...(r.event_tickets ?? [])].sort((a, b) => a.seq - b.seq);
+          const canCancel = r.status === "pending" && !payments.some((p) => p.status !== "pending");
+          return (
+            <article key={r.id} className={`rounded-2xl border bg-card p-6 ${r.status === "cancelled" ? "opacity-60" : ""}`}>
+              <div className="flex flex-wrap items-start justify-between gap-3">
+                <div>
+                  <h3 className="text-xl text-foreground">
+                    {r.events ? <Link to="/eventos/$slug" params={{ slug: r.events.slug }} className="hover:underline">{r.events.title}</Link> : "Evento"}
+                  </h3>
+                  <p className="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
+                    <CalendarDays className="h-4 w-4" /> {r.events ? fmtDateTime(r.events.starts_at) : ""}
+                    {r.events?.location ? ` · ${r.events.location}` : ""}
+                  </p>
+                  <p className="mt-1 text-sm text-muted-foreground">
+                    {r.event_lots?.name} · {r.quantity} {r.quantity === 1 ? "ingresso" : "ingressos"}
+                    {r.total > 0 ? ` · ${moneyBR(r.total)}` : ""}
+                  </p>
+                </div>
+                <Badge variant={r.status === "confirmed" ? "default" : "secondary"}>{REGISTRATION_STATUS[r.status] ?? r.status}</Badge>
+              </div>
+
+              {r.status === "pending" && (
+                <div className="mt-5 space-y-4">
+                  <PaymentInstructions eventId={r.event_id} />
+                  <div className="divide-y rounded-xl border">
+                    {payments.map((p) => (
+                      <div key={p.id} className="flex flex-wrap items-center justify-between gap-3 p-4 text-sm">
+                        <div>
+                          <p className="font-medium text-foreground">
+                            {payments.length > 1 ? `Parcela ${p.installment_no} de ${payments.length}` : "Pagamento"} — {moneyBR(p.amount)}
+                          </p>
+                          <Badge variant={p.status === "paid" ? "default" : "outline"} className="mt-1">{PAYMENT_STATUS[p.status] ?? p.status}</Badge>
+                          {p.proof_path && (
+                            <button type="button" className="ml-3 text-xs text-primary underline" onClick={() => openProof(p.proof_path!)}>Ver comprovante enviado</button>
+                          )}
+                        </div>
+                        {p.status !== "paid" && (
+                          <div className="flex flex-wrap gap-2">
+                            <Button type="button" size="sm" variant="outline" disabled={claim.isPending} onClick={() => { setUploadFor(p.id); fileRef.current?.click(); }}>
+                              <Upload className="h-4 w-4" /> Enviar comprovante
+                            </Button>
+                            {p.status === "pending" && (
+                              <Button type="button" size="sm" disabled={claim.isPending} onClick={() => claim.mutate({ paymentId: p.id })}>Já efetuei o pagamento</Button>
+                            )}
+                          </div>
+                        )}
+                      </div>
+                    ))}
+                  </div>
+                  <p className="text-xs text-muted-foreground">O ingresso é liberado depois que a igreja confirmar {payments.length > 1 ? "todas as parcelas" : "o pagamento"}.</p>
+                  {canCancel && (
+                    <Button type="button" variant="ghost" size="sm" onClick={() => confirm("Cancelar esta inscrição?") && cancel.mutate(r.id)}>Cancelar inscrição</Button>
+                  )}
+                </div>
+              )}
+
+              {r.status === "confirmed" && (
+                <div className="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
+                  {tickets.map((t) => (
+                    <div key={t.id} className="flex flex-col items-center gap-3 rounded-xl border bg-background p-4 text-center">
+                      <TicketQr code={t.code} name={t.holder_name} />
+                      <div>
+                        <p className="font-medium text-foreground">{t.holder_name}</p>
+                        <p className="text-xs text-muted-foreground">Ingresso {t.seq} de {r.quantity}</p>
+                        <Badge className="mt-2" variant={t.status === "checked_in" ? "default" : "outline"}>{TICKET_STATUS[t.status] ?? t.status}</Badge>
+                      </div>
+                    </div>
+                  ))}
+                </div>
+              )}
+            </article>
+          );
+        })}
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/events/QrScanner.tsx b/src/components/events/QrScanner.tsx
new file mode 100644
index 0000000..faa9820
--- /dev/null
+++ b/src/components/events/QrScanner.tsx
@@ -0,0 +1,70 @@
+import { useEffect, useRef, useState } from "react";
+import jsQR from "jsqr";
+
+/** Lê QR codes pela câmera (precisa de HTTPS ou localhost). Chama onScan uma vez por leitura. */
+export function QrScanner({ onScan }: { onScan: (code: string) => void }) {
+  const videoRef = useRef<HTMLVideoElement>(null);
+  const [error, setError] = useState("");
+  const [ready, setReady] = useState(false);
+  const onScanRef = useRef(onScan);
+  onScanRef.current = onScan;
+
+  useEffect(() => {
+    let stream: MediaStream | null = null;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let stopped = false;
+    const last = { code: "", at: 0 };
+    const canvas = document.createElement("canvas");
+    const ctx = canvas.getContext("2d", { willReadFrequently: true });
+
+    async function start() {
+      if (!navigator.mediaDevices?.getUserMedia) {
+        setError("Este navegador não permite usar a câmera aqui. Abra o site com HTTPS ou digite o código manualmente.");
+        return;
+      }
+      try {
+        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false });
+      } catch {
+        setError("Não foi possível acessar a câmera. Libere a permissão no navegador ou digite o código manualmente.");
+        return;
+      }
+      const video = videoRef.current;
+      if (!video || stopped) return;
+      video.srcObject = stream;
+      await video.play().catch(() => undefined);
+      setReady(true);
+      const tick = () => {
+        if (stopped) return;
+        if (ctx && video.readyState === video.HAVE_ENOUGH_DATA && video.videoWidth > 0) {
+          canvas.width = video.videoWidth;
+          canvas.height = video.videoHeight;
+          ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
+          const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
+          const found = jsQR(img.data, img.width, img.height, { inversionAttempts: "dontInvert" });
+          if (found?.data && (found.data !== last.code || Date.now() - last.at > 3500)) {
+            last.code = found.data;
+            last.at = Date.now();
+            onScanRef.current(found.data);
+          }
+        }
+        timer = setTimeout(tick, 200);
+      };
+      tick();
+    }
+    start();
+    return () => {
+      stopped = true;
+      if (timer) clearTimeout(timer);
+      stream?.getTracks().forEach((t) => t.stop());
+    };
+  }, []);
+
+  if (error) return <p className="rounded-xl border border-destructive/40 bg-destructive/5 p-4 text-sm text-destructive">{error}</p>;
+  return (
+    <div className="relative overflow-hidden rounded-2xl border bg-black">
+      <video ref={videoRef} playsInline muted className="aspect-square w-full object-cover sm:aspect-video" />
+      {!ready && <p className="absolute inset-0 grid place-items-center text-sm text-white/80">Abrindo a câmera...</p>}
+      <div className="pointer-events-none absolute inset-8 rounded-2xl border-2 border-white/70" />
+    </div>
+  );
+}
