@@ -0,0 +1,45 @@
+create or replace function public.delete_user_account(_user uuid, _delete_member boolean default false)
+returns void language plpgsql security definer set search_path = public as $$
+declare uid uuid := auth.uid();
+begin
+  if not public.is_church_leadership(uid) then raise exception 'Acesso negado'; end if;
+  if _user = uid then raise exception 'cannot_delete_self'; end if;
+  if not exists (select 1 from auth.users where id = _user) then raise exception 'user_not_found'; end if;
+  if public.has_role(_user, 'ceo') then raise exception 'cannot_delete_ceo'; end if;
+  if public.has_role(_user, 'pastor_presidente') and not public.has_role(uid, 'ceo') then raise exception 'only_ceo_deletes_president'; end if;
+  if _delete_member then
+    delete from public.members where user_id = _user;
+  end if;
+  delete from auth.users where id = _user;
+end $$;
+revoke all on function public.delete_user_account(uuid, boolean) from public, anon;
+grant execute on function public.delete_user_account(uuid, boolean) to authenticated;
+
+create or replace function public.cancel_event_registration(_reg uuid)
+returns void language plpgsql security definer set search_path = public as $$
+declare uid uuid := auth.uid(); r public.event_registrations%rowtype; staff boolean;
+begin
+  if uid is null then raise exception 'login_required'; end if;
+  select * into r from public.event_registrations where id = _reg;
+  if not found then raise exception 'not_found'; end if;
+  staff := public.has_permission(uid, 'verify_event_payments') or public.has_permission(uid, 'manage_events');
+  if not staff then
+    if r.user_id <> uid then raise exception 'Acesso negado'; end if;
+    if r.status <> 'pending' or exists (select 1 from public.event_payments p where p.registration_id = _reg and p.status in ('claimed', 'paid')) then
+      raise exception 'cannot_cancel';
+    end if;
+  end if;
+  if r.status = 'cancelled' then return; end if;
+  update public.event_registrations set status = 'cancelled', cancelled_at = now() where id = _reg;
+  update public.event_tickets set status = 'cancelled' where registration_id = _reg;
+  update public.event_payments set proof_path = null where registration_id = _reg and proof_path is not null;
+end $$;
+
+create or replace function public.dashboard_volunteer_stats()
+returns jsonb language sql stable security definer set search_path = public as $$
+  select jsonb_build_object('departments', count(distinct d.id), 'volunteers', count(distinct dm.member_id))
+  from public.departments d
+  left join public.department_members dm on dm.department_id = d.id
+  where (public.has_permission(auth.uid(), 'view_departments') or public.has_permission(auth.uid(), 'manage_departments'))
+    and public.can_view_department(auth.uid(), d.id);
+$$;
diff --git a/supabase/migrations/20261019161010_department_multiple_leaders.sql b/supabase/migrations/20261019161010_department_multiple_leaders.sql
new file mode 100644
index 0000000..1a84688
--- /dev/null
+++ b/supabase/migrations/20261019161010_department_multiple_leaders.sql
@@ -0,0 +1,97 @@
+-- Vários líderes (opcionais) por departamento
+create table if not exists public.department_leaders (
+  department_id uuid not null references public.departments(id) on delete cascade,
+  member_id uuid not null references public.members(id) on delete cascade,
+  created_at timestamptz not null default now(),
+  primary key (department_id, member_id)
+);
+create index if not exists department_leaders_member_idx on public.department_leaders(member_id);
+
+alter table public.department_leaders enable row level security;
+
+create policy "department_leaders read" on public.department_leaders
+  for select to authenticated using (public.can_view_department(auth.uid(), department_id));
+create policy "department_leaders insert" on public.department_leaders
+  for insert to authenticated with check (public.has_permission(auth.uid(), 'manage_departments'));
+create policy "department_leaders delete" on public.department_leaders
+  for delete to authenticated using (public.has_permission(auth.uid(), 'manage_departments'));
+
+-- Copia o líder único atual para a nova tabela
+insert into public.department_leaders (department_id, member_id)
+select id, leader_member_id from public.departments where leader_member_id is not null
+on conflict do nothing;
+
+comment on column public.departments.leader_member_id is 'DEPRECATED: use public.department_leaders (vários líderes por departamento)';
+
+-- Quem sai do departamento deixa de ser líder dele
+create or replace function public.department_members_clear_leader()
+returns trigger language plpgsql security definer set search_path to 'public' as $$
+begin
+  delete from public.department_leaders where department_id = old.department_id and member_id = old.member_id;
+  return old;
+end $$;
+
+-- Líder (qualquer um) mantém as permissões de líder no departamento
+create or replace function public.has_dept_permission(_user_id uuid, _dept uuid, _perm text)
+returns boolean language sql stable security definer set search_path to 'public' as $$
+  select _user_id is not null and (
+    public.is_church_leadership(_user_id)
+    or public.has_permission(_user_id, 'manage_departments')
+    or exists (
+      select 1 from public.members m
+      join public.church_roles r on r.id = m.church_role_id
+      where m.user_id = _user_id and _perm = any (r.permissions)
+        and (
+          r.scope = 'all'
+          or (r.scope = 'selected' and exists (
+                select 1 from public.church_role_departments rd where rd.role_id = r.id and rd.department_id = _dept))
+          or (r.scope = 'linked' and exists (
+                select 1 from public.department_members dm where dm.member_id = m.id and dm.department_id = _dept))
+        )
+    )
+    or exists (
+      select 1 from public.department_leaders dl
+      join public.members m on m.id = dl.member_id
+      where m.user_id = _user_id and dl.department_id = _dept
+        and _perm in ('dept_view', 'dept_manage_members', 'dept_report')
+    )
+  );
+$$;
+
+-- Visão geral: lista de líderes (ids e nomes)
+drop function if exists public.department_overview();
+create function public.department_overview()
+returns table (id uuid, name text, description text, leader_member_ids uuid[], leader_names text[], member_count bigint, created_at timestamptz)
+language sql stable security definer set search_path to 'public' as $$
+  select d.id, d.name, d.description,
+         coalesce((select array_agg(dl.member_id order by lm.full_name) from public.department_leaders dl
+                   join public.members lm on lm.id = dl.member_id where dl.department_id = d.id), '{}'::uuid[]),
+         coalesce((select array_agg(lm.full_name order by lm.full_name) from public.department_leaders dl
+                   join public.members lm on lm.id = dl.member_id where dl.department_id = d.id), '{}'::text[]),
+         (select count(*) from public.department_members dm where dm.department_id = d.id), d.created_at
+  from public.departments d
+  where public.can_view_department(auth.uid(), d.id)
+     or exists (select 1 from public.department_members dm join public.members m on m.id = dm.member_id
+                where dm.department_id = d.id and m.user_id = auth.uid())
+  order by d.name;
+$$;
+
+-- Lista de membros: is_leader passa a olhar a nova tabela
+create or replace function public.department_roster(_dept uuid)
+returns table (member_id uuid, full_name text, phone text, email text, photo_path text, status text, church_role_id uuid, role_name text, joined_at timestamptz, is_leader boolean)
+language plpgsql stable security definer set search_path to 'public' as $$
+begin
