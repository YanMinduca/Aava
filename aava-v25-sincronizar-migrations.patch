diff --git a/supabase/migrations/20261024213810_event_image_consent.sql b/supabase/migrations/20261024213810_event_image_consent.sql
new file mode 100644
index 0000000..4854786
--- /dev/null
+++ b/supabase/migrations/20261024213810_event_image_consent.sql
@@ -0,0 +1,83 @@
+alter table public.events
+  add column if not exists require_image_consent boolean not null default false;
+
+alter table public.event_registrations
+  add column if not exists image_consent boolean not null default false,
+  add column if not exists image_consent_at timestamptz;
+
+drop function if exists public.register_for_event(uuid, uuid, integer, text, integer);
+
+create or replace function public.register_for_event(
+  _event uuid, _lot uuid, _quantity integer, _cpf text,
+  _installments integer default 1, _image_consent boolean default false
+)
+returns uuid
+language plpgsql
+security definer
+set search_path to 'public'
+as $function$
+declare
+  uid uuid := auth.uid();
+  ev public.events%rowtype; lt public.event_lots%rowtype; m public.members%rowtype;
+  is_member boolean; d text; used int; total numeric; reg uuid; pay_required boolean; n int; base numeric; i int;
+  consent boolean;
+begin
+  if uid is null then raise exception 'login_required'; end if;
+  select * into ev from public.events where id = _event and published;
+  if not found then raise exception 'event_not_found'; end if;
+  if now() < coalesce(ev.registration_opens_at, '-infinity') or now() > coalesce(ev.registration_closes_at, 'infinity') then
+    raise exception 'registration_closed';
+  end if;
+  consent := ev.require_image_consent and coalesce(_image_consent, false);
+  if ev.require_image_consent and not consent then raise exception 'image_consent_required'; end if;
+
+  select * into lt from public.event_lots where id = _lot and event_id = _event for update;
+  if not found then raise exception 'lot_not_found'; end if;
+  if (lt.opens_at is not null and now() < lt.opens_at) or (lt.closes_at is not null and now() > lt.closes_at) then
+    raise exception 'lot_closed';
+  end if;
+  select * into m from public.members where user_id = uid;
+  if not found then raise exception 'profile_required'; end if;
+  is_member := m.approval_status = 'aprovado' and m.status <> 'visitante';
+  if ev.audience = 'members' and not is_member and not lt.public_access then raise exception 'members_only'; end if;
+  if _quantity is null or _quantity < 1 or _quantity > 10 then raise exception 'invalid_quantity'; end if;
+
+  d := regexp_replace(coalesce(nullif(btrim(_cpf), ''), m.cpf, ''), '\D', '', 'g');
+  if ev.limit_per_person then
+    if not public.is_valid_cpf(d) then raise exception 'invalid_cpf'; end if;
+    select coalesce(sum(r.quantity), 0) into used from public.event_registrations r
+      where r.event_id = _event and r.status <> 'cancelled'
+        and (r.user_id = uid or regexp_replace(coalesce(r.attendee_cpf, ''), '\D', '', 'g') = d);
+    if used + _quantity > coalesce(ev.max_per_person, 1) then raise exception 'limit_exceeded'; end if;
+  elsif d <> '' and not public.is_valid_cpf(d) then
+    raise exception 'invalid_cpf';
+  end if;
+
+  if lt.capacity is not null and public.lot_taken(lt.id) + _quantity > lt.capacity then raise exception 'sold_out'; end if;
+
+  pay_required := ev.payment_enabled and lt.price > 0;
+  total := lt.price * _quantity;
+  n := case when pay_required and coalesce(_installments, 1) > 1 then _installments else 1 end;
+  if n > 1 and (not ev.allow_installments or n > ev.max_installments) then raise exception 'invalid_installments'; end if;
+
+  insert into public.event_registrations (event_id, lot_id, user_id, member_id, attendee_name, attendee_cpf, attendee_phone, attendee_email,
+                                          quantity, unit_price, total, installments, status, image_consent, image_consent_at)
+  values (_event, _lot, uid, m.id, m.full_name, nullif(d, ''), m.phone, coalesce(m.email, (select u.email from auth.users u where u.id = uid)),
+          _quantity, lt.price, total, n, case when pay_required then 'pending' else 'confirmed' end,
+          consent, case when consent then now() end)
+  returning id into reg;
+
+  if pay_required then
+    base := round(total / n, 2);
+    for i in 1..n loop
+      insert into public.event_payments (registration_id, installment_no, amount)
+      values (reg, i, case when i = n then total - base * (n - 1) else base end);
+    end loop;
+  else
+    perform public.issue_event_tickets(reg);
+  end if;
+  return reg;
+end $function$;
+
+revoke all on function public.register_for_event(uuid, uuid, integer, text, integer, boolean) from public, anon;
+grant execute on function public.register_for_event(uuid, uuid, integer, text, integer, boolean) to authenticated, service_role;
diff --git a/supabase/migrations/20261024215941_member_duplicates_and_orphan_selection.sql b/supabase/migrations/20261024215941_member_duplicates_and_orphan_selection.sql
new file mode 100644
index 0000000..7e9cd90
--- /dev/null
+++ b/supabase/migrations/20261024215941_member_duplicates_and_orphan_selection.sql
@@ -0,0 +1,91 @@
+create unique index if not exists members_cpf_digits_key
+  on public.members ((regexp_replace(cpf, '\D', '', 'g')))
+  where length(regexp_replace(coalesce(cpf, ''), '\D', '', 'g')) = 11;
+
+create or replace function public.find_member_duplicates(_name text, _cpf text, _rg text, _exclude uuid default null)
+returns table (
+  id uuid, full_name text, registration_number text, status text, approval_status text,
+  has_account boolean, match_name boolean, match_cpf boolean, match_rg boolean
+)
+language plpgsql stable security definer set search_path = public as $$
+declare
+  n text := public.norm_name(_name);
+  c text := regexp_replace(coalesce(_cpf, ''), '\D', '', 'g');
+  r text := regexp_replace(lower(coalesce(_rg, '')), '[^0-9a-z]', '', 'g');
+begin
+  if auth.uid() is null
+     or not (public.has_permission(auth.uid(), 'view_members')
+          or public.has_permission(auth.uid(), 'create_member')
+          or public.has_permission(auth.uid(), 'edit_member')) then
+    raise exception 'Acesso negado';
+  end if;
+  if coalesce(array_length(string_to_array(n, ' '), 1), 0) < 2 then n := null; end if;
+  if length(c) <> 11 then c := null; end if;
+  if length(r) < 5 then r := null; end if;
+  if n is null and c is null and r is null then return; end if;
+  return query
+    with x as (
+      select m.id as mid, m.full_name as mname, m.registration_number as mreg, m.status as mstatus,
+             m.approval_status as mappr, (m.user_id is not null) as macc,
+             (n is not null and public.norm_name(m.full_name) = n) as mn,
+             (c is not null and regexp_replace(coalesce(m.cpf, ''), '\D', '', 'g') = c) as mc,
+             (r is not null and regexp_replace(lower(coalesce(m.rg, '')), '[^0-9a-z]', '', 'g') = r) as mr
+      from public.members m
+      where _exclude is null or m.id <> _exclude
+    )
+    select x.mid, x.mname, x.mreg, x.mstatus, x.mappr, x.macc, x.mn, x.mc, x.mr
+    from x where x.mn or x.mc or x.mr
+    order by x.mc desc, x.mr desc, x.mn desc, x.mname
+    limit 5;
+end $$;
+
+create or replace function public.check_cpf_for_signup(_cpf text)
+returns table (id uuid, masked_name text, state text)
+language plpgsql security definer set search_path = public as $$
+declare
+  uid uuid := auth.uid();
+  c text := regexp_replace(coalesce(_cpf, ''), '\D', '', 'g');
+begin
+  if uid is null then raise exception 'Acesso negado'; end if;
+  if length(c) <> 11 then return; end if;
+  if (select count(*) from public.member_claim_attempts a
+        where a.user_id = uid and a.kind = 'lookup' and a.created_at > now() - interval '1 hour') >= 30 then
+    return query select null::uuid, null::text, 'limited'::text;
+    return;
+  end if;
+  insert into public.member_claim_attempts (user_id, kind) values (uid, 'lookup');
+  return query
+    select m.id,
+           split_part(btrim(m.full_name), ' ', 1)
+             || coalesce(' ' || (select string_agg(left(w, 1) || '.', ' ')
+                                   from unnest((string_to_array(btrim(m.full_name), ' '))[2:]) w where w <> ''), ''),
+           case when m.user_id is not null then 'in_use'
+                when m.approval_status = 'aprovado' then 'claimable'
+                else 'pending' end
+    from public.members m
+    where regexp_replace(coalesce(m.cpf, ''), '\D', '', 'g') = c
+      and m.user_id is distinct from uid
+    limit 1;
+end $$;
+
+create or replace function public.storage_enqueue_orphans_selected(_items jsonb)
+returns int language plpgsql security definer set search_path = public as $$
+declare n int;
+begin
+  if not public.is_church_leadership(auth.uid()) then raise exception 'Acesso negado'; end if;
+  with wanted as (
+    select i ->> 'bucket' as b, i ->> 'path' as p from jsonb_array_elements(coalesce(_items, '[]'::jsonb)) i
+  ), ins as (
+    insert into public.storage_trash (bucket, path)
+    select o.bucket, o.path from public.storage_orphans_preview() o
+    join wanted w on w.b = o.bucket and w.p = o.path
+    on conflict (bucket, path) do nothing
+    returning 1)
+  select count(*) into n from ins;
+  return n;
+end $$;
+
+revoke all on function public.find_member_duplicates(text, text, text, uuid), public.check_cpf_for_signup(text),
+  public.storage_enqueue_orphans_selected(jsonb) from public, anon;
+grant execute on function public.find_member_duplicates(text, text, text, uuid), public.check_cpf_for_signup(text),
+  public.storage_enqueue_orphans_selected(jsonb) to authenticated, service_role;
diff --git a/supabase/migrations/20261025040916_push_notifications.sql b/supabase/migrations/20261025040916_push_notifications.sql
